# Copy this file to ".env" and fill in your values. Never commit ".env".

# --- Telegram ---
MASTER_BOT_TOKEN=123456:ABC-your-master-bot-token
OWNER_TELEGRAM_ID=123456789
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_from_my.telegram.org

# --- Firebase ---
FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
# Option A (local): path to the service-account JSON (keep it out of git)
FIREBASE_CREDENTIALS_FILE=firebase_credentials.json
# Option B (Render): paste the whole JSON on one line instead of using the file
# FIREBASE_CREDENTIALS_JSON=

# --- Keep-alive (Render) ---
# Bot A (main.py): optional Bot B URL so A pings B too
# PARTNER_URL=https://reaction-bot-b.onrender.com
# Bot B (ping_bot.py): Bot A URL(s), comma-separated; interval fallback in seconds
# TARGET_URLS=https://reaction-bot-a.onrender.com
# PING_MIN=240
# PING_MAX=480
# PORT is set automatically by Render
